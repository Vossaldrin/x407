# Arno — Environment Variables
#
# This file mixes two separate runtimes — split it accordingly:
#   - Frontend (NEXT_PUBLIC_*, PYTHON_API, WalletConnect) -> copy to .env.local
#     at the project root (Next.js convention).
#   - Backend (BASE_RPC_URL, SELF_API_URL, DEMO_MERCHANT_ADDRESS, and the
#     *_API_KEY vars below) -> copy to backend/.env — main.py loads that file
#     specifically (backend/main.py's load_dotenv() call), NOT .env.local.

# Python backend (local dev)
PYTHON_API=http://localhost:8000

# RPC endpoints
NEXT_PUBLIC_BASE_RPC=https://mainnet.base.org
NEXT_PUBLIC_ARB_RPC=https://arb1.arbitrum.io/rpc
NEXT_PUBLIC_ETH_RPC=https://eth.llamarpc.com

# Optional: WalletConnect
NEXT_PUBLIC_WC_PROJECT_ID=

# Real x402-style payments (backend/x402.py) — Base mainnet by default
BASE_RPC_URL=https://mainnet.base.org
SELF_API_URL=http://localhost:8000
# Wallet that receives payments in the built-in /demo/compute-api merchant.
# Point this at a wallet you control to test the full pay-for-API loop.
DEMO_MERCHANT_ADDRESS=

# Required for the Research Agent's report synthesis and the agent chat
# dispatcher (backend/llm.py, backend/ai_providers.py)
ANTHROPIC_API_KEY=

# Optional — power advisory AI insights (backend/ai_providers.py). Without
# these the insights just don't render; nothing else is affected.
OPENAI_API_KEY=
GEMINI_API_KEY=
# Grok (xAI) — API payment insight. OpenAI-compatible; https://api.x.ai/v1
GROK_API_KEY=
# DeepSeek — research source suggestions. OpenAI-compatible; https://api.deepseek.com
DEEPSEEK_API_KEY=
# Kimi (Moonshot AI) — wallet spending summary. OpenAI-compatible; https://api.moonshot.ai/v1
KIMI_API_KEY=

# Figma personal access token — used one-off to pull the design for
# React-component conversion, not read by the running app.
FIGMA_API_KEY=
